# GenLayer RPC used by direct-mode placeholders and Studio-mode scripts.
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# The contract address is hard-set in src/lib/genlayer.ts (CONTRACT_ADDRESS),
# not read from the environment.

# Frontend (Vite) — network selection only; the contract address is in code.
VITE_NETWORK=studionet

# Only needed for Studio-mode integration tests on Bradbury. Never commit real keys.
ACCOUNT_PRIVATE_KEY_1=
